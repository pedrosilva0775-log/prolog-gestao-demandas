{
  "name": "prolog",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:infra": "docker compose up -d postgres",
    "predev": "npm run db:migrate",
    "dev": "tsx server.ts",
    "build:client": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=build/server.mjs",
    "build:migrate": "esbuild scripts/migrate.ts --bundle --platform=node --format=esm --packages=external --outfile=build/migrate.mjs",
    "build:create-admin": "esbuild scripts/create-admin.ts --bundle --platform=node --format=esm --packages=external --outfile=build/create-admin.mjs",
    "build": "npm run build:client && npm run build:server && npm run build:migrate && npm run build:create-admin",
    "start": "cross-env NODE_ENV=production node build/server.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "retention:enforce": "tsx scripts/enforce-retention.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:create-admin": "tsx scripts/create-admin.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "cross-env RUN_DB_TESTS=true UPLOAD_DIR=.test-uploads node --env-file=.env node_modules/vitest/vitest.mjs run src/server/app.integration.test.ts"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "framer-motion": "^13.1.1",
    "google-auth-library": "^11.0.2",
    "helmet": "^8.3.0",
    "html-to-image": "^1.11.13",
    "kysely": "^0.29.5",
    "lucide-react": "^0.546.0",
    "pg": "^8.23.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.4.21",
    "cross-env": "^7.0.3",
    "esbuild": "^0.25.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.11"
  }
}
