# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Autenticação PROLOG. Troque os valores antes de publicar.
DATABASE_URL="postgresql://prolog:troque-esta-senha@localhost:5432/prolog"
DB_SSL="false"
DB_POOL_SIZE="10"
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""
BOOTSTRAP_ADMIN_NAME="Administrador"
SESSION_SECRET=""
LOG_HASH_SECRET=""
# Defina apenas atrás de proxy confiável e com topologia conhecida.
TRUST_PROXY="false"
PASSWORD_RESET_WEBHOOK_URL=""
PASSWORD_RESET_WEBHOOK_SECRET=""
METRICS_TOKEN=""
# Gere com: openssl rand -base64 32
MFA_ENCRYPTION_KEY=""
REQUIRE_ADMIN_MFA="false"

# ID do cliente OAuth 2.0 do tipo "Aplicativo da Web" no Google Cloud.
# Cadastre http://localhost:3000 entre as origens JavaScript autorizadas.
GOOGLE_CLIENT_ID=""

# Recursos fora do escopo da v1.0. Habilite somente quando houver backend real.
VITE_FEATURE_GOOGLE_WORKSPACE="false"
VITE_FEATURE_ANDROID="false"
VITE_FEATURE_WEBHOOKS="false"
VITE_FEATURE_AUTOMATIONS="false"
VITE_FEATURE_BACKUP_UI="false"
VITE_FEATURE_SLA_ADVANCED="false"
VITE_FEATURE_APPROVALS="false"
VITE_FEATURE_RISKS="false"
VITE_FEATURE_RECURRENCE="false"
VITE_FEATURE_SCHEDULED_REPORTS="false"
VITE_FEATURE_OFFLINE_MODE="false"
